# Copia este archivo a ".env" (NO se commitea, ver .gitignore) y completa
# valores reales antes de "docker compose up".

# Contraseña del login "sa" de SQL Server (solo se usa para crear la base de
# datos y el login de la app la primera vez — el backend nunca se conecta como sa).
SA_PASSWORD=CambiaEsto123!Segura

# Contraseña del login dedicado "ramichan_app" que sí usa el backend en runtime.
DB_PASSWORD=OtraContraseñaSegura456!

# Secreto para firmar los JWT — mínimo 64 bytes aleatorios. Generar con:
#   openssl rand -base64 64
JWT_SECRET=GENERA_UN_SECRETO_ALEATORIO_DE_AL_MENOS_64_BYTES_AQUI

# Dominio(s) desde los que el navegador puede llamar a la API, separados por coma
# si hace falta más de uno. Con este docker-compose, frontend y backend quedan
# en el mismo origen (nginx los sirve juntos), pero Spring igual valida CORS.
CORS_ALLOWED_ORIGINS=https://tu-dominio.com

# Solo si pusiste Caddy (u otro reverse proxy) delante para HTTPS (ver
# deploy/DEPLOYMENT.md): descomenta estas dos líneas para que el contenedor del
# frontend deje de escuchar directo en el puerto 80 público (eso ahora lo hace
# Caddy) y pase a escuchar solo en localhost, en el puerto que le pases a Caddy.
# Sin Caddy, deja esto comentado — el frontend sigue expuesto directo en :80.
# FRONTEND_BIND=127.0.0.1
# FRONTEND_PORT=8081
